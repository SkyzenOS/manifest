<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="skyzen"
           fetch="https://github.com/SkyzenOS"
           revision="skyzen-16"
           sync-c="true"
           sync-j="4" />

  <!-- bootable -->
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" groups="pdk-cw" remote="skyzen" />
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="skyzen" />

  <!-- build -->
  <project path="build/make" name="build_make" groups="pdk,sysui-studio" remote="skyzen" >
    <copyfile src="core/root.mk" dest="Makefile" />
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="build_soong" groups="pdk,tradefed,sysui-studio" remote="skyzen" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- frameworks -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk,sysui-studio" remote="skyzen" />
  <project path="frameworks/base" name="frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="skyzen" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk" remote="skyzen" />

  <!-- manifest -->
  <project path="manifest" name="manifest" remote="skyzen" />

  <!-- packages -->
  <project path="packages/apps/Launcher3" name="packages_apps_Launcher3" groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="skyzen" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc" remote="skyzen" />
  <project path="packages/apps/SetupWizard" name="packages_apps_SetupWizard" remote="skyzen" />

  <!-- system -->
  <project path="system/core" name="system_core" groups="pdk" remote="skyzen" />
  <project path="system/sepolicy" name="system_sepolicy" groups="pdk" remote="skyzen" />

  <!-- vendor -->
  <project path="vendor/skyzen" name="vendor_skyzen" remote="skyzen" />

</manifest>
